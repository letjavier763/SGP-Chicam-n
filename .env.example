APP_NAME="SGP CAP Chicamán"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Guatemala

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
